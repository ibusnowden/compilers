# cumulative sum via pad + expand + shrink tricks: y[i] = sum_{j<=i} x[j]
# build m[i, j] = x[j] if j <= i else 0, then reduce the last axis
%x = [1 2 3 4]
%xx = expand (reshape %x [1 4]) [4 4]
%i = expand (reshape [0 1 2 3] [4 1]) [4 4]
%j = expand (reshape [0 1 2 3] [1 4]) [4 4]
%m = where (cmplt %i %j) (expand 0 [4 4]) %xx
%t = assert (reduce %m op=add pop=1) [1 3 6 10]
